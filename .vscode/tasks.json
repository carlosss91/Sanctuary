{
  "version": "2.0.0",
  "options": {
    "env": {
      "PATH": "C:\\src\\flutter\\bin;C:\\src\\flutter\\bin\\cache\\dart-sdk\\bin;C:\\Program Files\\nodejs;C:\\Program Files\\Git\\bin;C:\\Program Files\\Git\\cmd;C:\\Program Files\\Git\\usr\\bin;C:\\Program Files\\Docker\\Docker\\resources\\bin;${env:PATH}"
    }
  },
  "tasks": [
    {
      "label": "🚀 Sanctuary: Levantar Todo (Docker + Backend + Flutter Web)",
      "type": "shell",
      "command": "bash start.sh",
      "windows": {
        "command": "powershell -ExecutionPolicy Bypass -File .\\start.ps1"
      },
      "isBackground": true,
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": true
      }
    },
    {
      "label": "⏹️ Sanctuary: Detener Todo (Docker y Servicios)",
      "type": "shell",
      "command": "bash stop.sh",
      "windows": {
        "command": "powershell -ExecutionPolicy Bypass -File .\\stop.ps1"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "📱 Sanctuary: Compilar APK Android",
      "type": "shell",
      "command": "bash build_apk.sh",
      "windows": {
        "command": "flutter build apk"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "🌐 Sanctuary: Flutter Web (Modo Dev)",
      "type": "shell",
      "command": "flutter run -d web-server --web-port=8085 --web-hostname=0.0.0.0",
      "windows": {
        "command": "flutter run -d web-server --web-port=8085 --web-hostname=0.0.0.0"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "🔍 Sanctuary: Análisis de Código (Dart Analyze)",
      "type": "shell",
      "command": "flutter analyze",
      "problemMatcher": [
        "$dart-analyze"
      ],
      "group": {
        "kind": "test"
      }
    }
  ]
}
